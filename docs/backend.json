
{
  "entities": {
    "Donation": {
      "title": "Donation",
      "description": "A donation record submitted by a user for approval. Verified via AI to match MUGHER FULL GOSPEL CHURCH.",
      "type": "object",
      "properties": {
        "donorName": {
          "type": "string",
          "description": "Full name of the donor extracted from receipt or entered manually."
        },
        "amount": {
          "type": "number",
          "description": "Amount donated in ETB."
        },
        "receiptData": {
          "type": "string",
          "description": "Stored as null for AI-verified donations to save space."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Current status of the donation."
        },
        "referenceNumber": {
          "type": "string",
          "description": "Unique reference number for the transaction."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the donation was submitted."
        },
        "type": {
          "type": "string",
          "enum": ["Tithe", "Offering", "GoFund", "Special Seed", "Building Purposes"],
          "description": "Category of the donation."
        },
        "isAiVerified": {
          "type": "boolean",
          "description": "Whether the receipt was successfully scanned and verified against account 1000221935978."
        }
      },
      "required": ["donorName", "amount", "status", "referenceNumber", "timestamp"]
    },
    "Event": {
      "title": "Event",
      "description": "A church event or announcement.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "description"]
    },
    "Member": {
      "title": "Member",
      "description": "A member of the church congregation.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "group": { "type": "string", "description": "Ministry or group the member belongs to." },
        "joinedDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "maritalStatus": { "type": "string", "enum": ["Married", "Unmarried"] }
      },
      "required": ["name", "status"]
    },
    "Expense": {
      "title": "Expense",
      "description": "A recorded church expenditure.",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "approvedBy": { "type": "string" },
        "status": { "type": "string", "enum": ["Approved", "Pending", "Rejected"] }
      },
      "required": ["description", "amount", "date", "status"]
    },
    "Testimony": {
      "title": "Testimony",
      "description": "A personal story or idea shared by a community member.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "content": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "status": { "type": "string", "enum": ["pending", "approved"], "default": "pending" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "content", "timestamp"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/donations/{donationId}": {
      "schema": "Donation",
      "description": "Collection of donations for MUGHER FULL GOSPEL CHURCH."
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Collection of church events and announcements."
    },
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Collection of church members."
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Collection of church expenses."
    },
    "/testimonies/{testimonyId}": {
      "schema": "Testimony",
      "description": "Collection of shared testimonies and community ideas."
    }
  }
}
